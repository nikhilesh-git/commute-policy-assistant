# Copy to .env and fill in. Never commit .env.

# Leave empty to use a random per-run secret (fine for local demo).
# If set, it must be >= 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# fake = no network, no key (tests, offline eval). groq = real LLM for the demo.
LLM_PROVIDER=fake
GROQ_API_KEY=
# Measured fastest on our prompts. Alternative: openai/gpt-oss-20b with GROQ_REASONING_EFFORT=low
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none

# hybrid (embeddings + BM25 keywords, the default) | dense (embeddings only, the baseline)
RETRIEVAL_MODE=hybrid
